# Copy to .env for local Compose overrides (optional; Compose has matching defaults).
POSTGRES_USER=flight
POSTGRES_PASSWORD=flight
POSTGRES_DB=flight_tracker

# App / migrate (Compose sets these for the containers; use host-local values for go run).
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://flight:flight@localhost:5432/flight_tracker?sslmode=disable
MIGRATIONS_PATH=migrations/postgres

# Optional worker overrides (defaults are in the server binary).
# JOB_LEASE_TTL=90s

# Local/dev: disable API auth and rate limits. The server binary defaults to
# AUTH_DISABLED=false (fail closed). Never enable this in production.
AUTH_DISABLED=true

# Production bootstrap (only used when api_keys is empty). Generate with:
# python3 -c "import secrets; print('ftk_' + secrets.token_hex(4) + '_' + secrets.token_hex(16))"
# AUTH_BOOTSTRAP_ADMIN_KEY=
# RATE_LIMIT_TRUST_PROXY=false
# Shared Postgres RPM for missing/invalid/revoked credentials on protected
# routes (ip|<client IP>|auth_fail). Separate from RATE_LIMIT_ANON_RPM so
# auth spam cannot exhaust the anonymous public IP quota (including NATs).
# RATE_LIMIT_AUTH_FAIL_RPM=30

